 
 {
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
, "components/ui/Header.jsx", "components/ui/Hero.jsx", "app/(auth)/login/page.jsx", "constants/admin.js", "components/Banner.jsx", "providers/Socketprovider.tsx", "components/ui/Footer.jsx", "store/api.js", "store/StoreProvider.js", "app/SocketInitializer.tsx", "context/AuthSocketBridge.jsx", "app/consultations/[consultationId]/index.jsx", "providers/ConsultationSocketProvider.jsx", "app/not-found.jsx"  ],
  "exclude": ["node_modules"]
}
